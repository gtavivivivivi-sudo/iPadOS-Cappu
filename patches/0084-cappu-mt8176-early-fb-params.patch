diff --git a/osfmk/arm64/cappu_fbparams.h b/osfmk/arm64/cappu_fbparams.h
new file mode 100644
index 0000000..7aba2bf
--- /dev/null
+++ b/osfmk/arm64/cappu_fbparams.h
@@ -0,0 +1,38 @@
+/*
+ * Early (bootstrap) framebuffer parameters for the Mi Pad 3 (MT8176).
+ * Included from C and from assembly: only plain #defines here.
+ *
+ * CAPPU_EARLY_FB_PHYS = 0 disables the whole early console (no write to
+ * RAM, no extra mapping). The old Redmi value 0x9c000000 is ordinary DRAM
+ * on MT8176, writing there corrupts memory. Set the real address only after
+ * the M1 shim has printed /chosen atag,videolfb from the tablet:
+ *   -DCAPPU_EARLY_FB_PHYS=0x........ (U: format must be 32bpp, stride may differ)
+ *
+ * The mapping is one 32MB L2 block, so the block base is PHYS rounded down
+ * to 32MB and the framebuffer sits at OFF inside it.
+ */
+#ifndef _ARM64_CAPPU_FBPARAMS_H_
+#define _ARM64_CAPPU_FBPARAMS_H_
+
+#ifndef CAPPU_EARLY_FB_PHYS
+#define CAPPU_EARLY_FB_PHYS     0
+#endif
+#ifndef CAPPU_EARLY_FB_WIDTH
+#define CAPPU_EARLY_FB_WIDTH    1536
+#endif
+#ifndef CAPPU_EARLY_FB_HEIGHT
+#define CAPPU_EARLY_FB_HEIGHT   2048
+#endif
+#ifndef CAPPU_EARLY_FB_STRIDE
+#define CAPPU_EARLY_FB_STRIDE   6144    /* bytes per line (U: LK may pad) */
+#endif
+
+#ifdef __ASSEMBLER__
+#define CAPPU_EARLY_FB_BLOCK    (CAPPU_EARLY_FB_PHYS & ~0x1ffffff)
+#define CAPPU_EARLY_FB_OFF      (CAPPU_EARLY_FB_PHYS & 0x1ffffff)
+#else
+#define CAPPU_EARLY_FB_BLOCK    (CAPPU_EARLY_FB_PHYS & ~0x1ffffffULL)
+#define CAPPU_EARLY_FB_OFF      (CAPPU_EARLY_FB_PHYS & 0x1ffffffULL)
+#endif
+
+#endif
