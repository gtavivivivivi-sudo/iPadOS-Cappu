 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (CAPPU_EARLY_FB_PHYS + (CAPPU_EARLY_FB_HEIGHT - 32) * CAPPU_EARLY_FB_STRIDE)
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	MOV64	x4, CAPPU_EARLY_FB_STRIDE
 Lcappu_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -680,7 +681,7 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
-#if defined(CAPPU)
+#if defined(CAPPU) && (CAPPU_EARLY_FB_PHYS != 0)
 	/*
 	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
 	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
@@ -688,7 +689,7 @@ Lkernelcache_base_found:
 	 * CAPPU uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
