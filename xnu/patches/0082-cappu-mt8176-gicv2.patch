@@ -50,6 +54,38 @@
 #define gicr_write32(offset, data) (_gic_write32(gicr_pe_base + (offset), (data)))
 #define gicr_read64(offset) (_gic_read64(gicr_pe_base + (offset)))
 
+#if defined(CAPPU_GICV2)
+/* GICv2: gicr_base/gicr_size hold the CPU interface (GICC) region of the "reg" property. */
+#define gicc_read32(offset) (_gic_read32(gicr_base + (offset)))
+#define gicc_write32(offset, data) (_gic_write32(gicr_base + (offset), (data)))
+
+/* Interface bit of each logical CPU, read from GICD_ITARGETSR0 on that CPU. UNVERIFIED mapping. */
+static uint32_t cappu_gic_cpumask[MAX_CPUS];
+
+uint32_t
+cappu_gic_ack(void)
+{
+	return gicc_read32(GICC_IAR);
+}
+
+void
+cappu_gic_eoi(uint32_t iar)
+{
+	gicc_write32(GICC_EOIR, iar);
+}
+
+void
+cappu_gic_send_sgi(unsigned int logical_cpu, unsigned int sgi)
+{
+	uint32_t mask = (logical_cpu < MAX_CPUS) ? cappu_gic_cpumask[logical_cpu] : 0;
+	if (mask == 0) {
+		/* Target has not run pe_init_fiq yet: assume interface N = logical CPU N. UNVERIFIED. */
+		mask = 1U << (logical_cpu & 7);
+	}
+	/* TargetListFilter 0, CPUTargetList = mask, NSATT = 1 (Group 1) */
+	gicd_write32(GICD_SGIR, (mask << 16) | (1U << 15) | (sgi & 0xF));
+}
+#else
 static vm_offset_t
 find_gicr_pe_base()
 {
@@ -72,6 +108,7 @@
 
 	panic("%s: cannot find GICR base for core %u", __func__, ml_get_cpu_number(phys_id));
 }
+#endif /* CAPPU_GICV2 */
 
 void
 pe_init_fiq()
@@ -143,6 +180,34 @@
 		gicr_size = gicr_size_prop;
 	}
 
+#if defined(CAPPU_GICV2)
+	/*
+	 * GIC-400: PPI/SGI registers are banked per CPU inside the distributor and the
+	 * CPU interface is memory mapped, so there is no redistributor to find or wake.
+	 * Non-secure writes to GICD_IGROUPR0 may be ignored (secure firmware owns the
+	 * grouping); delivery of the arch timer PPI as an IRQ is expected, UNVERIFIED.
+	 */
+	gicd_write32(GICD_IGROUPR0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ISENABLER0, (1U << cappu_vtimer_intid) | (1U << CAPPU_IPI_SGI));
+	{
+		unsigned int cpu = ml_get_cpu_number_local();
+		if (cpu < MAX_CPUS) {
+			cappu_gic_cpumask[cpu] = gicd_read32(GICD_ITARGETSR0) & 0xFF;
+		}
+	}
+	gicc_write32(GICC_PMR, 0xFF);
+	gicc_write32(GICC_BPR, 0);
+	gicd_write32(GICD_CTLR, gicd_read32(GICD_CTLR) | GICD_CTLR_ENABLEGRP1);
+	gicc_write32(GICC_CTLR, GICC_CTLR_ENABLEGRP1);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+	kprintf("CAPPU GIC: GICv2 CPU%u iface mask 0x%x\n", ml_get_cpu_number_local(),
+	    cappu_gic_cpumask[ml_get_cpu_number_local() < MAX_CPUS ? ml_get_cpu_number_local() : 0]);
+#else /* !CAPPU_GICV2 */
+
 	// Find the redistributor for this processor
 	vm_offset_t gicr_pe_base = find_gicr_pe_base();
 
@@ -221,6 +286,7 @@
 	__builtin_arm_wsr64("ICC_IGRPEN0_EL1", 1);
 	__builtin_arm_isb(ISB_SY);
 #endif /* CAPPU */
+#endif /* CAPPU_GICV2 */
 }
 #else
 void
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
