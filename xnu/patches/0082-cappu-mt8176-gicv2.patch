diff --git a/pexpert/pexpert/arm64/CAPPU.h b/pexpert/pexpert/arm64/CAPPU.h
--- a/pexpert/pexpert/arm64/CAPPU.h
+++ b/pexpert/pexpert/arm64/CAPPU.h
@@ -38,6 +38,13 @@
 
 #define HAS_GIC_V3                1
 
+/*
+ * MT8176 (Mi Pad 3): ARM GIC-400 = GICv2, memory-mapped CPU interface, no
+ * redistributors and no ICC_* system registers (Cortex-A72 has none).
+ * pe_fiq.c / sleh.c / CappuCPU.cpp switch on CAPPU_GICV2. UNTESTED on hardware.
+ */
+#define CAPPU_GICV2               1
+
 #ifndef ASSEMBLER
 #define PLATFORM_PANIC_LOG_DISABLED
 #endif /* ! ASSEMBLER */
@@ -47,7 +54,7 @@
  * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
  * (CNTV) is INTID 16 + 3 = 19.
  */
-#define CAPPU_VTIMER_INTID        19
+#define CAPPU_VTIMER_INTID        27      /* MT8176 dts: PPI 11 -> INTID 16 + 11 */
 #define CAPPU_IPI_SGI             1       // SGI used for cross-CPU signals
 
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
@@ -80,4 +87,18 @@
 #define ICC_SRE_SRE                             0x1
 /* End of GICv3 register definitions */
 
+/* GICv2 (GIC-400) register definitions; Arm IHI 0048B. PPI/SGI registers are banked per CPU in the distributor. */
+#define GICD_IGROUPR0             0x080
+#define GICD_ISENABLER0           0x100
+#define GICD_IPRIORITYR0          0x400
+#define GICD_ITARGETSR0           0x800   /* read-only for PPI/SGI: this CPU's interface bit */
+#define GICD_SGIR                 0xF00
+#define GICC_CTLR                 0x000
+#define GICC_PMR                  0x004
+#define GICC_BPR                  0x008
+#define GICC_IAR                  0x00C
+#define GICC_EOIR                 0x010
+#define GICC_CTLR_ENABLEGRP1      0x1     /* non-secure view */
+#define GIC_INTID_MASK            0x3FF   /* IAR[9:0]; IAR[12:10] is the SGI source CPU */
+
 #endif /* ! _PEXPERT_ARM64_CAPPU_H */
