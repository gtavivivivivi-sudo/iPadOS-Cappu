cappu: build XNU for ARMv8.0 (Cortex-A72 of the MT8176), no LSE atomics

The CAPPU machine config inherited -march=armv8.2-a+crypto from the Snapdragon port. With it the
compiler emits LSE atomics (LDADD/SWP/CAS...) and the hand-written asm takes its ARMv8.2 branches.
A Cortex-A72 is ARMv8.0 and has no LSE, so the first atomic would be an undefined instruction.
Found by tools/scan_lse.py on the Actions build: 865 LSE instruction words in kernel.development.cappu.

- makedefs/MakeInc.def: -march=armv8-a+crypto (crypto kept as before; whether the MT8176 A72 has it is unknown (U))
- osfmk/arm/commpage/commpage_asm.s: the two unconditional `casa` in _pfz_trylock_and_enqueue/_dequeue get an
  ldaxr/stxr fallback under #if !defined(__ARM_ARCH_8_2__). machine_routines_asm.s is already guarded by that macro.
Verified here only: the fallback assembles under -march=armv8-a (clang), plain `casa` is rejected there.
NOT verified: the full XNU build with the new flag (needs the Actions macOS runner), then rescan with tools/scan_lse.py.

diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 9695f88..98ad3a2 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -61,7 +61,7 @@ MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=ap
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
-MACHINE_FLAGS_ARM64_CAPPU = -DARM64_BOARD_CONFIG_CAPPU                -march=armv8.2-a+crypto
+MACHINE_FLAGS_ARM64_CAPPU = -DARM64_BOARD_CONFIG_CAPPU                -march=armv8-a+crypto
 
 
 #
diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..b418749 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,7 +273,18 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if defined(__ARM_ARCH_8_2__)
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+#else
+	/* Cortex-A72 (ARMv8.0) has no LSE: same acquire CAS with an exclusive loop. w10 = old value, w12 scratch. */
+1:	ldaxr	w10, [x3]
+	cbnz	w10, 2f
+	stxr	w12, w11, [x3]
+	cbnz	w12, 1b
+	b	3f
+2:	clrex
+3:
+#endif
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +334,18 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if defined(__ARM_ARCH_8_2__)
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+#else
+	/* Cortex-A72 (ARMv8.0) has no LSE: same acquire CAS with an exclusive loop. w10 = old value, w12 scratch. */
+1:	ldaxr	w10, [x2]
+	cbnz	w10, 2f
+	stxr	w12, w11, [x2]
+	cbnz	w12, 1b
+	b	3f
+2:	clrex
+3:
+#endif
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
